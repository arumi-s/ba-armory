		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/sortablejs": "^1.15.9",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
